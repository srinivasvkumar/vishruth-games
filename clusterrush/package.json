{
  "name": "cluster-rush",
  "version": "0.1.0",
  "description": "3D endless runner game built with Three.js and TypeScript using TDD methodology",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "build": "tsc -p tsconfig.node.json && vite build --config config/vite.config.ts",
    "preview": "vite preview --config config/vite.config.ts",
    "lint": "eslint --config config/eslint.config.js src config scripts",
    "lint:fix": "eslint --config config/eslint.config.js src config scripts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"config/**/*.ts\" \"scripts/**/*.ts\"",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "preinstall": "npx only-allow npm",
    "prepare": "husky",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "analyze": "node scripts/build-analyzer.js",
    "deploy": "node scripts/deploy.js",
    "validate": "node scripts/validate.js"
  },
  "dependencies": {
    "three": "^0.162.0",
    "cannon-es": "^0.20.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/three": "^0.162.0",
    "@types/node": "^20.11.0",
    "vite": "^5.3.0",
    "vitest": "^1.6.0",
    "@vitest/coverage-v8": "^1.6.0",
    "@vitest/ui": "^1.6.0",
    "@playwright/test": "^1.40.0",
    "eslint": "^8.57.0",
    "@eslint/js": "^9.5.0",
    "typescript-eslint": "^7.13.1",
    "prettier": "^3.2.5",
    "husky": "^9.0.11",
    "globals": "^15.9.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "vite-plugin-checker": "^0.6.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^0.20.0"
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "threejs",
    "webgl",
    "game",
    "typescript",
    "vite",
    "tdd",
    "test-driven-development",
    "web-game",
    "3d-game",
    "endless-runner",
    "physics-game",
    "cannon-es",
    "webassembly",
    "progressive-web-app"
  ],
  "author": "Vishruth",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/[username]/vishruth-games.git",
    "directory": "clusterrush"
  },
  "bugs": {
    "url": "https://github.com/[username]/vishruth-games/issues"
  },
  "homepage": "https://[username].github.io/vishruth-games/clusterrush",
  "packageManager": "npm@10.5.0",
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/[username]"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "sideEffects": false
}