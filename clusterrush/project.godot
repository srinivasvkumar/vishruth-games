; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited inline if you're sure.
; In case of discrepancy between the contents of this file and
; the UI-stored configuration, the UI configuration takes precedence.

config_version=5

[autoload]

AudioManager="*res://autoloads/audio_manager.gd"
GameManager="*res://autoloads/game_manager.gd"
InputManager="*res://autoloads/input_manager.gd"
LevelManager="*res://autoloads/level_manager.gd"

[application]

config/name="ClusterRush"
config/description="Cluster Rush - WebGL Game"
run/main_scene="res://scenes/game.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld_landscape=true

[rendering]

renderer_backend/gl_compatibility=false
environment/defaults/default_clear_color=Color(0.1, 0.1, 0.15, 1)
