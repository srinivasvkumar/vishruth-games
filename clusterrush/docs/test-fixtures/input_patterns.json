{
  "patterns": {
    "tutorial_basic": {
      "description": "Basic tutorial: strafe left, jump, strafe right",
      "duration_seconds": 10.0,
      "inputs": [
        {"key": "StrafeLeft", "hold": 1.5, "repeat": 2},
        {"key": "Jump", "type": "tap"},
        {"key": "StrafeRight", "hold": 1.5, "repeat": 2},
        {"key": "Jump", "type": "tap"},
        {"key": "StrafeLeft", "hold": 1.0, "repeat": 1}
      ]
    },
    "double_jump_pattern": {
      "description": "Double jump in mid-air",
      "duration_seconds": 3.0,
      "inputs": [
        {"key": "Jump", "type": "tap", "when": "grounded"},
        {"key": "Jump", "type": "tap", "when": "airborne", "delay_seconds": 0.3}
      ]
    },
    "wall_climb_pattern": {
      "description": "Detect wall and climb up",
      "duration_seconds": 4.0,
      "inputs": [
        {"key": "Climb", "hold": 2.0, "when": "near_wall"},
        {"key": "Jump", "type": "tap", "when": "at_top"}
      ]
    },
    "convoy_traversal": {
      "description": "Jump between multiple trucks in sequence",
      "duration_seconds": 15.0,
      "inputs": [
        {"key": "Jump", "type": "tap", "when": "truck_1"},
        {"key": "StrafeLeft", "hold": 0.5},
        {"key": "Jump", "type": "tap", "when": "truck_2"},
        {"key": "StrafeRight", "hold": 0.5},
        {"key": "Jump", "type": "tap", "when": "truck_3"}
      ]
    },
    "edge_case_rapid_input": {
      "description": "P8-T02: Spam 100 jump inputs in 1 second",
      "duration_seconds": 1.0,
      "inputs": [
        {"key": "Jump", "type": "tap", "burst": 100, "interval_ms": 10}
      ]
    },
    "edge_case_pause_mid_hazard": {
      "description": "P8-T03: Pause while touching hazard",
      "duration_seconds": 8.0,
      "inputs": [
        {"key": "Pause", "type": "tap", "when": "near_saw_blade"},
        {"wait": 2.0},
        {"key": "Pause", "type": "tap"},
        {"key": "Jump", "type": "tap"}
      ]
    },
    "input_buffer_test": {
      "description": "Test 0.1s input buffer for forgiving controls",
      "duration_seconds": 2.0,
      "inputs": [
        {"key": "Jump", "type": "tap", "delay_before_ground": 0.1},
        {"key": "Jump", "type": "tap", "delay_before_ground": 0.14},
        {"key": "Jump", "type": "tap", "delay_before_ground": 0.16}
      ],
      "expected": "First two taps succeed, third fails (beyond coyote time)"
    }
  }
}
